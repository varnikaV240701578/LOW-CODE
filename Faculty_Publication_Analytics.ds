		menu
		{
			space Space
			{
				displayname = "Space"
				icon = "objects-spaceship"

				section Publications
				{
					displayname = "Publications"
					icon = "education-books-46"
					form  Publication
					{
						icon = "education-book-open"
					}
					report All_Publications
					{
						icon = "tech-desktop"
					}
					report Department_Year_Repor
					{
						icon = "education-book-open"
					}
				}
				section ZC_App_Preferences
				{
					displayname = "App Preferences"
					icon = "design-app"
					systemcomponent
					{
						type = localization
						displayname = "Language Selection"
						icon = "education-language"
					}
					systemcomponent
					{
						type = connection
						displayname = "Integrations"
						icon = "tech-2-connection"
					}
				}
				section ZC_Approvals
				{
					displayname = "Approvals"
					icon = "ui-2-hourglass"
					systemcomponent
					{
						type = approval
						approval status = pending
						displayname = "Pending Tasks"
						icon = "ui-2-hourglass"
					}
					systemcomponent
					{
						type = approval
						approval status = completed
						displayname = "Completed Tasks"
						icon = "design-todo"
					}
				}
				section SharedAnalytics_Section
				{
					type = shared_user_report_section
					displayname = "Reports"
					icon = "business-chart-bar-33"
				}
				section Publication_Dashboard
				{
					displayname = "Publication_Dashboard"
					icon = "tech-desktop"
					page Publication_Dashboard
					{
						icon = "tech-desktop"
					}
				}
			}
			preference
			{
				icon
				{
					style = outline
				}
			}
		}
