				}
			}
			Monthly_Placement_and_Int as "Monthly Placement and Internship Summary"
			{
				type =  schedule
					status = inactive
				start = "2026-11-07 09:00:00"
				frequency = monthly
				time zone = "UTC"
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "thendral2311@gmail.com"
							subject : "Monthly Placement and Internship Summary"
							message : "<div><span>Hello, Please review the monthly student registration, company details, internship opportunities, placement applications, interviews, and offer updates. Thank you.</span><br></div>"
						)
					}
				}
			}
		}

		approval
		{
			Student_Application_Appro as "Student Application Approval"
			{
				type =  approval
				form = Student_Application
				display fields = [Student_Name,Opportunity_Type,Internship_Opportunity,Placement_Opportunity,Application_Date,Application_Status,Remarks]
				on start
				{
				}
				on level 1
				{
					on approve 
					{
						actions 
						{
							sendmail
							(
								from : "zoho.loginuserid"
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : "zoho.loginuserid"
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
					}
				}
			}
		}

