		form Placement_Opportunity
		{
			displayname = "Placement Opportunity"
			success message = "Placement Opportunity Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Job_Title
			(
    			type = text
				displayname = "Job Title"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Company_Registration
			(
				type = picklist	
				displayname = "Company Registration."
				values  = Company_Registration.ID
    			displayformat = [Company_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Job_Description
			(
    			type = textarea
				displayname = "Job Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Minimum_CGPA
			(
				type = decimal
				displayname = "Minimum CGPA"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Salary_Package_LPA
			(
				type = number
				displayname = "Salary Package (LPA)"
	 			row = 1
	 			column = 1   
				width = medium
			)
