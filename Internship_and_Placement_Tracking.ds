 application "Internship and Placement Tracking"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "UTC"
 	time format = "24-hr"

 	forms
	{
		form Company_Registration
		{
			displayname = "Company Registration."
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Company_Name
			(
    			type = text
				displayname = "Company Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Industry
			(
				type = picklist
				maxchar = 100
				values = {"Information Technology (IT)","Software Development","Banking and Finance","Telecommunications","Manufacturing","Education","E-commerce","Media and Entertainment"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Contact_Person
			(
    			type = text
				displayname = "Contact Person"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Contact_Email
			(
    			type = email
				displayname = "Contact Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Contact_Phone
			(
    			type = phonenumber
				displayname = "Contact Phone"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Company_Website
			(
    			type = url
				displayname = "Company Website"
				enable  linkname
	 			row = 1
	 			column = 1   
				width = medium
			)
			Company_Address
			(
    			type = address
				displayname = "Company Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Company_Description
			(
    			type = textarea
				displayname = "Company Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Internship_Opportunity
		{
			displayname = "Internship Opportunity"
			success message = "Internship Opportunity Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Internship_Title
			(
    			type = text
				displayname = "Internship Title"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Company_name
			(
				type = picklist	
				displayname = "Company name"
				values  = Company_Registration.ID
    			displayformat = [Company_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Job_Description
			(
    			type = textarea
				displayname = "Job Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Stipend
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Start_Date
			(
    			type = date
				displayname = "Start Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have End_Date
			(
    			type = date
				displayname = "End Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Location
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Status
			(
				type = picklist
				maxchar = 100
				values = {"Open","Closed","Filled","On hold"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Internship_Progress_Tracking
		{
			displayname = "Internship Progress Tracking"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have student_application
			(
				type = picklist	
				displayname = "Student Application"
				values  = Student_Application.ID
    			displayformat = [ID]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have internship_opportunity
			(
				type = picklist	
				displayname = "Internship Opportunity"
				values  = Internship_Opportunity.ID
    			displayformat = [ID]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have progress_update_date
			(
    			type = date
				displayname = "Progress Update Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			tasks_completed
			(
    			type = textarea
				displayname = "Tasks Completed"
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			skills_learned
			(
    			type = textarea
				displayname = "Skills Learned"
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have progress_percentage
			(
				type = number
				displayname = "Progress Percentage"
	 			row = 1
	 			column = 1   
				width = medium
			)
			mentor_comments
			(
    			type = textarea
				displayname = "Mentor Comments"
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have internship_status
			(
				type = picklist
				displayname = "Internship Status"
				maxchar = 100
				values = {"Not Started","In Progress","Completed","Discontinued"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_by
			(
    			type = picklist
				displayname = "Created By"
				module = users
				displayformat = [username]
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_modified_date
			(
    			type = datetime
				displayname = "Last Modified Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Interview_Scheduling
		{
			displayname = "Interview Scheduling"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Student_Application
			(
				type = picklist	
				displayname = "Student Application"
				values  = Student_Application.ID
    			displayformat = [Opportunity_Type]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Interview_Date
			(
    			type = date
				displayname = "Interview Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Interview_Time
			(
    			type = time
				displayname = "Interview Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Interview_Mode
			(
				type = picklist
				displayname = "Interview Mode"
				maxchar = 100
				values = {"Online","Offline","Hybrid"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Interview_Round
			(
				type = picklist
				displayname = "Interview Round"
				maxchar = 100
				values = {"Aptitude Test","Technical Round","HR Round","Final Round"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Interview_Link_Venue
			(
    			type = text
				displayname = "Interview Link / Venue"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Interview_Status
			(
				type = picklist
				displayname = "Interview Status"
				maxchar = 100
				values = {"Scheduled","Completed","Rescheduled","Cancelled"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Interview_Feedback
			(
    			type = textarea
				displayname = "Interview Feedback"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
