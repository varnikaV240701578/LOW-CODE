				values = {"Full-time","Part-time","Graduate Trainee Trainee"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Status
			(
				type = picklist
				maxchar = 100
				values = {"Open","Closed","Filled","On hold"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
