		workflow
		{
		form
		{
			show_hide_fields as "show/hide fields"
			{
				type =  form
				form = Self_Service_Form

				record event = on add or edit

				field rules
				{
					actions  (What_do_you_want_to_track == "Tasks")
					{
						hide Add_a_New_Bug,Track_Projects,Track_Assets,Expense_Claim,Something_Else;
					}
					actions  (What_do_you_want_to_track == "Bugs")
					{
						hide Add_Tasks,Track_Projects,Track_Assets,Expense_Claim,Something_Else;
					}
					actions  (What_do_you_want_to_track == "Projects")
					{
						hide Add_Tasks,Add_a_New_Bug,Track_Assets,Expense_Claim,Something_Else;
					}
					actions  (What_do_you_want_to_track == "Assets")
					{
						hide Add_Tasks,Add_a_New_Bug,Expense_Claim,Track_Projects,Something_Else;
					}
					actions  (What_do_you_want_to_track == "Expenses")
					{
						hide Add_Tasks,Add_a_New_Bug,Track_Assets,Track_Projects,Something_Else;
					}
					actions  (What_do_you_want_to_track is null)
					{
						hide Expense_Claim,Add_Tasks,Add_a_New_Bug,Track_Assets,Track_Projects,Something_Else;
					}
					actions  (What_do_you_want_to_track == "Something else")
					{
						hide Expense_Claim,Add_Tasks,Add_a_New_Bug,Track_Assets,Track_Projects;
					}
				}

			}
			Set_Application_Status_on_Submit as "Set Application Status on Submit"
			{
				type =  form
				form = Student_Application

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Set the Application Status to 'Applied' upon successful submission
										input.Application_Status = "Applied";
						)
					}
				}

			}
			Set_Interview_Status_on_Submit as "Set Interview Status on Submit"
			{
				type =  form
				form = Interview_Scheduling

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Update the Interview_Status field to 'Scheduled' for the current record
										input.Interview_Status = "Scheduled";
						)
					}
				}

			}
			Internship_Progress_Completion_Automation as "Internship Progress Completion Automation"
			{
				type =  form
				form = Internship_Progress_Tracking

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Validate Progress Percentage is between 0 and 100
										if(input.progress_percentage < 0 || input.progress_percentage > 100)
										{
											info "Progress Percentage must be between 0 and 100";
											// Note: cancel submit is only available in On Validate actions. 
											// If this script runs on On Success, validation errors should be handled via alerts or custom logic.
										}
										// If Progress Percentage equals 100, set Internship Status to Completed
										if(input.progress_percentage == 100)
										{
											input.internship_status = "Completed";
										}
						)
					}
				}

			}
			Initialize_Placement_Offer_Status as "Initialize Placement Offer Status"
			{
				type =  form
				form = Placement_and_Offer_Details

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Set the Offer_Status field to "Offered" on successful submission
										input.Offer_Status = "Offered";
						)
					}
				}

			}
			Notify_Placement_Officer_On_New_Application as "Notify Placement Officer on New Application"
			{
				type =  form
				form = Student_Application

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch student name from the lookup field
										studentRecord = Student_Registration[ID == input.Student_Name];
										studentName = studentRecord.Student_name.first_name;
										// Prepare email details
										emailSubject = "New Student Application Received - " + input.Opportunity_Type;
										emailMessage = "<p>Dear Placement Officer,</p>";
										emailMessage = emailMessage + "<p>A new application has been submitted with the following details:</p>";
										emailMessage = emailMessage + "<ul>";
										emailMessage = emailMessage + "<li><strong>Student Name:</strong> " + studentName + "</li>";
										emailMessage = emailMessage + "<li><strong>Opportunity Type:</strong> " + input.Opportunity_Type + "</li>";
										emailMessage = emailMessage + "<li><strong>Application Date:</strong> " + toString(input.Application_Date,"MMM dd, yyyy") + "</li>";
										emailMessage = emailMessage + "<li><strong>Application Status:</strong> " + input.Application_Status + "</li>";
										emailMessage = emailMessage + "</ul>";
										emailMessage = emailMessage + "<p>Please review the application at your earliest convenience.</p>";
										// Send email notification
										sendmail
										[
											from :zoho.adminuserid
											to :zoho.adminuserid
											subject :emailSubject
											message :emailMessage
											content type :HTML
										]
						)
					}
				}

			}
			Validate_Progress_Percentage_Range as "Validate Progress Percentage Range"
			{
				type =  form
				form = Internship_Progress_Tracking

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.progress_percentage < 0 || input.progress_percentage > 100)
										{
											alert "Progress Percentage must be between 0 and 100";
										}
						)
					}
				}

			}
			Student_Application_Approval_Workflow as "Student Application Approval Workflow"
			{
				type =  form
				form = Student_Application

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the student name details from the lookup field
										studentRecord = Student_Registration[ID == input.Student_Name];
										// Construct the approval message with student details
										approvalMessage = "<p>Dear Administrator,</p>" + "<p>A new student application has been submitted for your review.</p>" + "<p><strong>Student Name:</strong> " + studentRecord.Student_name.first_name + " " + studentRecord.Student_name.last_name + "</p>" + "<p><strong>Email:</strong> " + studentRecord.Email + "</p>" + "<p><strong>Application Type:</strong> " + input.Opportunity_Type + "</p>" + "<p><strong>Opportunity:</strong> " + input.Internship_Opportunity + "</p>" + "<p>Please review the application and take appropriate action.</p>" + "<p>Best Regards,</p>" + "<p>Student Portal System</p>";
										// Send email to administrator with approval instructions
										sendmail
										[
											from :zoho.adminuserid
											to :zoho.adminuserid
											subject :"New Student Application for Approval - " + studentRecord.Student_name.first_name + " " + studentRecord.Student_name.last_name
											message :approvalMessage
											content type :HTML
										]
										// Update the application status to 'Under Review'
										input.Application_Status = "Under Review";
										// Display success message to the user
										success message "Your application has been submitted successfully and is under review by the administrator.";
						)
					}
				}

			}
		}

		schedule
		{
			Daily_Pending_Application as "Daily Pending Application Reminder"
			{
				type =  schedule
					status = inactive
				start = "2026-11-01 09:00:00"
				frequency = daily
				time zone = "UTC"
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "thendral2311@gmail.com"
							subject : "Daily Pending Student Application Reminder"
							message : "<div>Dear Placement Officer, <br></div><div><br></div><div>This is a daily reminder to review pending student applications in the Internship and Placement Tracking System.<br></div><div><br></div><div>Please check the Student Application records and update the application statuses accordingly.<br></div><div><br></div><div>Thank you.<br></div>"
						)
					}
				}
			}
