		form Self_Service_Form
		{
			displayname = "Self Service Form"
			success message = "Self Service Added Successfully"
			What_do_you_want_to_do1
			(
				type = section
				displayname = "What do you want to do?"
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain1
			(
    			type = plaintext
				value = "<p style=\"margin: 0px 0px 0pt; line-height: 1.2; text-align: left; direction: ltr\" class=\"zw-paragraph heading0\"><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\">💡 </span><span class=\"size\" style=\"font-size: 12pt; font-weight: 600; vertical-align: baseline\">Creator tip:</span><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\"> Use this sample form to capture data. Below is an example of how it may look.</span></span></span><br /></p><p style=\"margin: 0px 0px 0pt; line-height: 1.2; text-align: left; direction: ltr\" class=\"zw-paragraph heading0\"><br /></p><div><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\">Feel free to tweak things via the </span></span></span><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\">form builder. Every form submission is recorded in a </span></span></span><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\">r</span></span></span><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\">eport and can be visuali</span></span></span><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\">z</span></span></span><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\">ed.</span></span></span><br /></div><div><br /></div><div><span class=\"highlight\" style=\"background-color: rgba(0, 0, 0, 0)\"><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; letter-spacing: 0pt\">N</span></span></span></span><span class=\"highlight\" style=\"background-color: rgba(0, 0, 0, 0)\"><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; letter-spacing: 0pt\">ote: </span></span></span></span><span class=\"highlight\" style=\"background-color: rgba(0, 0, 0, 0)\"><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; font-variant: normal; text-decoration: none; letter-spacing: 0pt; font-weight: 400; vertical-align: baseline; font-style: normal\">If you're capturing sensitive data via a field,</span></span></span></span><span class=\"highlight\" style=\"background-color: rgba(0, 0, 0, 0)\"><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; font-variant: normal; text-decoration: none; letter-spacing: 0pt; font-weight: 400; vertical-align: baseline; font-style: normal\"> take a look at its properties to make it secured.</span></span></span></span><br /></div><div><span class=\"highlight\" style=\"background-color: rgba(0, 0, 0, 0)\"><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; font-variant: normal; text-decoration: none; letter-spacing: 0pt; font-weight: 400; vertical-align: baseline; font-style: normal\"></span></span></span></span><br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			What_do_you_want_to_track
			(
				type = picklist
				displayname = "What do you want to track?"
				maxchar = 100
				values = {"Tasks","Bugs","Projects","Expenses","Assets","Something else"}
	 			row = 1
	 			column = 1   
				width = large
			)
			Add_Tasks
			(
				type = section
				displayname = "Add Tasks"
				visibility = true
	 			row = 2
