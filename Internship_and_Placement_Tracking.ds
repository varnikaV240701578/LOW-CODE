	 			column = 1   
				width = medium
			)
			Bug_Title
			(
    			type = text
				displayname = "Bug Title"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Date_Reported
			(
    			type = date
				displayname = "Date Reported"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Severity
			(
				type = picklist
				maxchar = 100
				values = {"Low","Medium","Critical"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Status1
			(
				type = picklist
				displayname = "Status"
				maxchar = 100
				values = {"Open","Escalated","Closed"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Description1
			(
    			type = text
				displayname = "Description"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Track_Projects
			(
				type = section
				displayname = "Track Projects"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Project_Name
			(
    			type = text
				displayname = "Project Name"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Project_Manager
			(
    			type = picklist
				displayname = "Project Manager"
				module = users
				displayformat = [username]
	 			row = 4
	 			column = 1   
				width = medium
				personal data = true
			)
			Start_Date
			(
    			type = date
				displayname = "Start Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
			End_Date
			(
    			type = date
				displayname = "End Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
			Status2
			(
				type = picklist
				displayname = "Status"
				maxchar = 100
				values = {"Not Started","On-Track","Delayed","Live"}
				others option = true
	 			row = 4
	 			column = 1   
				width = medium
			)
			Summary
			(
    			type = text
	 			row = 4
	 			column = 1   
				width = medium
			)
			Expense_Claim
			(
				type = section
				displayname = "Expense Claim"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Expense_Date
			(
    			type = date
				displayname = "Expense Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 5
	 			column = 1   
				width = medium
			)
			Amount
			(
				type = USD
				format = commadotwestern
	 			row = 5
	 			column = 1   
				width = medium
			)
			Expense_Type
			(
				type = picklist
				displayname = "Expense Type"
				maxchar = 100
				values = {"Travel - Client Meeting","Meals","Accommodation","Software Subscription"}
				others option = true
	 			row = 5
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = text
	 			row = 5
	 			column = 1   
				width = medium
			)
			Track_Assets
			(
				type = section
				displayname = "Track Assets"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Asset_Type
			(
				type = picklist
				displayname = "Asset Type"
				maxchar = 100
				values = {"Laptop","Monitor","Mouse","Headphones","Mobile"}
				others option = true
	 			row = 6
	 			column = 1   
				width = medium
			)
			Purchase_Date
			(
    			type = date
				displayname = "Purchase Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 6
	 			column = 1   
				width = medium
			)
			Usecase
			(
    			type = text
	 			row = 6
	 			column = 1   
				width = medium
			)
			Something_Else
			(
				type = section
				displayname = "Something Else"
				visibility = true
	 			row = 7
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<div>\n <span style=\"font-family: Lato, sans-serif\" class=\"font\"><span style=\"font-size: 16px\" class=\"size\">Want to tailor this form to your specific needs? If this form doesn't cover your requirement, simply navigate to 'Edit this Application' at the top right to enter Edit Mode. </span></span>\n <br>\n</div>\n<div>\n <br>\n</div>\n<div>\n <span style=\"font-family: Lato, sans-serif\" class=\"font\"><span style=\"font-size: 16px\" class=\"size\">Here, you can open the form and add your unique fields.</span></span>\n <br>\n</div>\n<div>\n <br>\n</div>\n<div>\n <span style=\"font-family: Lato, sans-serif\" class=\"font\"><span style=\"font-size: 16px\" class=\"size\">For guidance on adding and customizing fields, <a style=\"color: rgb(0, 0, 238)\" rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://help.zoho.com/portal/en/kb/creator/developer-guide/forms/add-and-manage-fields/articles/understand-fields\">click here to access</a> our quick guide.</span></span>\n <br>\n</div>"
	 			row = 7
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Student_Application
		{
			displayname = "Student Application"
			success message = "Student Application Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Student_Name
			(
				type = picklist	
				displayname = "Student Name"
				values  = Student_Registration.ID
    			displayformat = [" " + Student_name.first_name + " " + Student_name.last_name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Opportunity_Type
			(
				type = picklist
				displayname = "Opportunity Type"
				maxchar = 100
				values = {"Internship","Placement"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Internship_Opportunity
			(
				type = picklist	
				displayname = "Internship Opportunity"
				values  = Internship_Opportunity.ID
    			displayformat = [Internship_Title]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Placement_Opportunity
			(
				type = picklist	
				displayname = "Placement Opportunity"
				values  = Placement_Opportunity.ID
    			displayformat = [Job_Title]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Application_Date
			(
    			type = date
				displayname = "Application Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Resume
			(
    			type = upload file
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			Application_Status
			(
				type = picklist
				displayname = "Application Status"
				maxchar = 100
				values = {"Applied","Under Review","Shortlisted","Rejected","Selected","Interview Scheduled"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Remarks
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Stage1","Stage2","Stage3","Shortlisted","Under Review","Interview Scheduled","Selected","Rejected","Applied"}
			}
		}
		form Student_Registration
		{
			displayname = "Student Registration"
			success message = "Student Registration Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Student_name
			(
    			type = name
				displayname = "Student's name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Phone_number1
			(
    			type = phonenumber
				displayname = "Phone number"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Register_Number
			(
    			type = text
				displayname = "Register Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Department
			(
				type = picklist
				maxchar = 100
				values = {"CSE","IT","ECE","EEE","Mechanical","Civil"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Year_of_study
			(
				type = picklist
				displayname = "Year of study"
				maxchar = 100
				values = {"1st year","2nd year","3rd year","4th year"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have CGPA
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list All_Bugs
		{
			displayName = "All Bugs"
			show all rows from Self_Service_Form  [What_do_you_want_to_track == "Bugs"]  
			(
				What_do_you_want_to_track as "What do you want to track?"
				Task_name as "Task name"
				Due_Date as "Due Date"
				Priority
				Status as " Status"
				Description
				Auto_Number as "Auto Number"
				Bug_Title as "Bug Title"
				Date_Reported as "Date Reported"
				Severity
				Status1 as "Status"
				Description1 as "Description"
				Project_Name as "Project Name"
				Project_Manager as "Project Manager"
				Start_Date as "Start Date"
				End_Date as "End Date"
				Status2 as "Status"
				Summary
				Expense_Date as "Expense Date"
				Amount
				Expense_Type as "Expense Type"
				Notes
				Asset_Type as "Asset Type"
				Purchase_Date as "Purchase Date"
				Usecase
			)
		}
		default list All_Trackings
		{
			displayName = "All Tasks"
			show all rows from Self_Service_Form  [What_do_you_want_to_track == "Tasks"]  
			(
				Task_name as "Task name"
				Priority
				Status as " Status"
				Auto_Number as "Auto Number"
				Status1 as "Status"
				Severity
				Project_Manager as "Project Manager"
				End_Date as "End Date"
				Status2 as "Status"
				Summary
				Notes
				Asset_Type as "Asset Type"
				Purchase_Date as "Purchase Date"
				Usecase
				Due_Date as "Due Date"
				Description
			)
		}
		default list All_Student_Registrations
		{
			displayName = "All Student Registrations"
			show all rows from Student_Registration    
			(
				Student_name  as "Student's name"
				Email
				Phone_number1 as "Phone number"
				(
					displayformat = plainnumber 
				)
				Register_Number as "Register Number"
				Department
				Year_of_study as "Year of study"
				CGPA
			)
		}
		default list Company_Registration_Report
		{
			displayName = "Company Registration. Report"
			show all rows from Company_Registration    
			(
				Company_Name as "Company Name"
				Industry
				Contact_Person as "Contact Person"
				Contact_Email as "Contact Email"
				Contact_Phone as "Contact Phone"
				(
					displayformat = plainnumber 
				)
				Company_Website as "Company Website"
				Company_Address  as "Company Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Company_Description as "Company Description"
			)
		}
		default list All_Internship_Opportunities
		{
			displayName = "All Internship Opportunities"
			show all rows from Internship_Opportunity    
			(
				Internship_Title as "Internship Title"
				Company_name as "Company name"
				Job_Description as "Job Description"
				Stipend
				Start_Date as "Start Date"
				End_Date as "End Date"
				Location
				Status
			)
		}
		default list All_Placement_Opportunities
		{
			displayName = "All Placement Opportunities"
			show all rows from Placement_Opportunity    
			(
				Job_Title as "Job Title"
				Company_Registration as "Company Registration."
				Job_Description as "Job Description"
				Minimum_CGPA as "Minimum CGPA"
				Salary_Package_LPA as "Salary Package (LPA)"
				Job_Location as "Job Location"
				Application_Deadline as "Application Deadline"
				Job_Type as "Job Type"
				Status
			)
		}
		default list All_Student_Applications
		{
			displayName = "All Student Applications"
			show all rows from Student_Application    
			(
				Student_Name as "Student Name"
				Opportunity_Type as "Opportunity Type"
				Internship_Opportunity as "Internship Opportunity"
				Placement_Opportunity as "Placement Opportunity"
				Application_Date as "Application Date"
				Resume
				Application_Status as "Application Status"
				Remarks
			)
		}
		default list Interview_Scheduling_Report
		{
			displayName = "Interview Scheduling Report"
			show all rows from Interview_Scheduling    
			(
				Student_Application as "Student Application"
				Interview_Date as "Interview Date"
				Interview_Time as "Interview Time"
				Interview_Mode as "Interview Mode"
				Interview_Round as "Interview Round"
				Interview_Link_Venue as "Interview Link / Venue"
				Interview_Status as "Interview Status"
				Interview_Feedback as "Interview Feedback"
			)
		}
		default list Internship_Progress_Tracking_Report
		{
			displayName = "Internship Progress Tracking Report"
			show all rows from Internship_Progress_Tracking    
			(
				student_application as "Student Application"
				internship_opportunity as "Internship Opportunity"
				progress_update_date as "Progress Update Date"
				tasks_completed as "Tasks Completed"
				skills_learned as "Skills Learned"
				progress_percentage as "Progress Percentage"
				mentor_comments as "Mentor Comments"
				internship_status as "Internship Status"
				created_by as "Created By"
				last_modified_date as "Last Modified Date"
			)
		}
		default list Placement_and_Offer_Details_Report
		{
			displayName = "Placement and Offer Details Report"
			show all rows from Placement_and_Offer_Details    
			(
				Student_Application as "Student Application"
				Company_Name as "Company Name"
				Job_Title as "Job Title"
				Salary_Package_LPA as "Salary Package (LPA)"
				Offer_Date as "Offer Date"
				Joining_Date as "Joining Date"
				Offer_Status as "Offer Status"
				Offer_Letter as "Offer Letter"
				Remarks
			)
		}
	}
	pages
	{
		page Tracker_Dashbaord
		{
			displayname = "Tracker Dashboard"
