			must have Application_Deadline
			(
    			type = date
				displayname = "Application Deadline"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Job_Type
			(
				type = picklist
				displayname = "Job Type"
