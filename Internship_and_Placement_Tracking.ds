							subject : "Weekly Internship and Placement Reminder"
							message : "<p><span>Hello,</span><br></p><p><span>This </span><span>is </span><span>the </span><span>weekly </span><span>reminder </span><span>for </span><span>the </span><span>Internship </span><span>and </span><span>Placement </span><span>Tracking </span><span>System.</span><br></p><p><span>Please </span><span>review </span><span>pending </span><span>student </span><span>applications, </span><span>upcoming </span><span>interviews, </span><span>internship </span><span>progress, </span><span>and </span><span>placement </span><span>updates.</span><br></p><p><span>Thank </span><span>you.</span><br></p><div><br></div>"
						)
